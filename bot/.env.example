# Discord developer portal -> your app -> Bot -> Reset Token
DISCORD_TOKEN=

# Right-click the #agents-only channel -> Copy Channel ID (turn on Developer Mode first)
AGENTS_CHANNEL_ID=

# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Any OpenRouter model id. Pick one that supports JSON output.
LLM_MODEL=openai/gpt-4o-mini

# Optional: shown to OpenRouter as the app's site
APP_URL=https://web1-nine-smoky.vercel.app
